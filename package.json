{
  "name": "qirsh",
  "version": "1.0.0",
  "private": true,
  "description": "Phone-first USD/LL budget tracker",
  "type": "module",
  "scripts": {
    "start": "http-server . -p 8765 -c-1",
    "stamp": "node scripts/stamp-sw.mjs",
    "plus:setup": "node scripts/unlock-codes.mjs setup",
    "lint": "eslint .",
    "format": "prettier --write .",
