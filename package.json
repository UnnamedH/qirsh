    "test:unit": "node --test \"unit/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "~1.64.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "http-server": "^14.1.1",
    "prettier": "^3.3.3",
    "typescript": "5.9"
  }
